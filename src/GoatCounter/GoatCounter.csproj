<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.GoatCounter</Product>
    <PackageId>Umbraco.Community.GoatCounter</PackageId>
    <Title>GoatCounter for Umbraco</Title>
    <Description>GoatCounter analytics for Umbraco: a backoffice dashboard, a Views tab on every page, and first-party page-view counting through your own site so blockers don't hide your visitors.</Description>
    <PackageTags>umbraco;goatcounter;analytics</PackageTags>
    <Authors>Andy Cross</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Andy Cross</Copyright>
    <PackageProjectUrl>https://github.com/AndyCross/umbraco-goatcounter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AndyCross/umbraco-goatcounter</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
